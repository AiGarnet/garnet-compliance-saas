{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express.js backend for monorepo project",
  "main": "dist/index.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "railway-start": "npm run build && cross-env PORT=8080 node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:alt": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "migrate": "node src/db/migrations/migrate.js",
    "migrate:rollback": "node src/db/migrations/migrate.js rollback",
    "migrate:legacy": "node src/db/migrations/create_users_table.js",
    "waitlist": "node src/waitlist-server.js",
    "test-db": "node src/test-db-connection.js",
    "create-waitlist-table": "node src/create-waitlist-table.js",
    "drop-waitlist-table": "node src/drop-waitlist-table.js",
    "check-waitlist-data": "node src/check-waitlist-data.js"
  },
  "dependencies": {
    "@types/multer": "^1.4.13",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "openai": "^4.103.0",
    "pg": "^8.11.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.5",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
